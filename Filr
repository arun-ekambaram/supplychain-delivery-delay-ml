# 8. FILL RATE COMPARISON  (from your existing cal_fill_rate logic)
# ══════════════════════════════════════════════════════════════════════════════

def compare_fill_rates(new_df, old_df):
    def fill_rate(df):
        return (df.notna().sum() / len(df) * 100).round(2)
    new_fr = fill_rate(new_df).rename("New Fill %")
    old_fr = fill_rate(old_df).rename("Old Fill %")
    fr = pd.concat([new_fr, old_fr], axis=1).reset_index()
    fr.columns = ["Column", "New Fill %", "Old Fill %"]
    fr["Diff"] = (fr["New Fill %"] - fr["Old Fill %"]).round(2)
    fr["Status"] = fr["Diff"].apply(
        lambda x: "⚠ FILL DROP >5%" if x < -5 else
                  "⬆ FILL IMPROVED" if x > 5 else "✓ SIMILAR"
    )
    return fr.sort_values("Diff")


