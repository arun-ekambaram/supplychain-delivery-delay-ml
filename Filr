# 9. SUMMARY SCORECARD
# ══════════════════════════════════════════════════════════════════════════════

def build_summary(row_df, date_df, monthly_df, dup_df, sc_id_df, col_compare_df):
    issues = []
    # Row count
    rc = row_df.iloc[0]
    issues.append({"Section":"Row Count","Finding": rc["Status"],
                   "Detail": f"Diff = {rc['Difference']:,} ({rc['Diff %']}%)"})
    # Duplicates
    for _, r in dup_df.iterrows():
        if r["Duplicate SC_IDs (All)"] > 0:
            issues.append({"Section":"Duplicates","Finding":"⚠ DUPLICATES FOUND",
                           "Detail": f"{r['Source']}: {r['Duplicate SC_IDs (All)']:,} dup SC_IDs"})
    # SC_ID overlap
    sc = sc_id_df.iloc[0]
    if sc["Only in New (extra)"] > 0:
        issues.append({"Section":"SC_ID Overlap","Finding":"⚠ EXTRA IDs in New",
                       "Detail": f"{sc['Only in New (extra)']:,} IDs only in new source (possible enhancement)"})
    if sc["Only in Old (missing)"] > 0:
        issues.append({"Section":"SC_ID Overlap","Finding":"⚠ MISSING IDs in New",
                       "Detail": f"{sc['Only in Old (missing)']:,} IDs dropped from new source"})
    # Column mismatches
    bad_cols = col_compare_df[col_compare_df["Issue Type"] != "✓ CLEAN"]
    issues.append({"Section":"Column Compare","Finding":
                   f"⚠ {len(bad_cols)} columns with issues" if len(bad_cols)>0 else "✓ All columns clean",
                   "Detail": ", ".join(bad_cols["Column"].head(10).tolist())})
    return pd.DataFrame(issues)


