# 1. ROW COUNTS
# ══════════════════════════════════════════════════════════════════════════════

def check_row_counts(new_df, old_df):
    new_cnt = len(new_df)
    old_cnt = len(old_df)
    diff    = new_cnt - old_cnt
    pct     = round(diff / old_cnt * 100, 2) if old_cnt else None
    result  = pd.DataFrame([{
        "Check"           : "Total Row Count",
        LABEL_NEW         : new_cnt,
        LABEL_OLD         : old_cnt,
        "Difference"      : diff,
        "Diff %"          : pct,
        "Status"          : "⚠ MISMATCH" if diff != 0 else "✓ MATCH",
        "Remarks"         : f"New has {abs(diff):,} {'more' if diff>0 else 'fewer'} rows"
    }])
    return result


# ══════════════════════════════════════════════════════════════════════════════
# 2. APPROVAL DATE RANGE CHECK
# ══════════════════════════════════════════════════════════════════════════════

def check_approval_date(new_df, old_df, date_col):
    rows = []
    for label, df in [(LABEL_NEW, new_df), (LABEL_OLD, old_df)]:
        s = pd.to_datetime(df[date_col])
        rows.append({
            "Source"    : label,
            "Min Date"  : s.min(),
            "Max Date"  : s.max(),
            "Null Count": s.isna().sum(),
            "Future Dates (> today)": (s > pd.Timestamp.today()).sum(),
            "Dates < 1990": (s < pd.to_datetime("1990-01-01")).sum(),
        })
    result = pd.DataFrame(rows)
    result["Status"] = result.apply(
        lambda r: "⚠ CHECK" if r["Null Count"] > 0 or r["Future Dates (> today)"] > 0 else "✓ OK",
        axis=1
    )
    return result


# ══════════════════════════════════════════════════════════════════════════════
# 3. MONTHLY RECORD COUNTS + LAST-MONTH vs THIS-MONTH DIFF
# ══════════════════════════════════════════════════════════════════════════════

def check_monthly_trend(new_df, old_df, date_col):
    def monthly_counts(df, label):
        s = pd.to_datetime(df[date_col])
        cnt = s.dt.to_period("M").value_counts().sort_index().reset_index()
        cnt.columns = ["Month", label]
        return cnt

    new_m = monthly_counts(new_df, LABEL_NEW)
    old_m = monthly_counts(old_df, LABEL_OLD)
    merged = pd.merge(new_m, old_m, on="Month", how="outer").sort_values("Month")
    merged["Diff"]   = merged[LABEL_NEW].fillna(0) - merged[LABEL_OLD].fillna(0)
    merged["Diff %"] = (merged["Diff"] / merged[LABEL_OLD].replace(0, np.nan) * 100).round(2)

    # Last month vs this month diff (within new source)
    new_sorted = new_m.sort_values("Month")
    new_sorted["MoM_Diff"]   = new_sorted[LABEL_NEW].diff()
    new_sorted["MoM_Diff %"] = new_sorted[LABEL_NEW].pct_change().mul(100).round(2)

    merged = pd.merge(merged, new_sorted[["Month","MoM_Diff","MoM_Diff %"]], on="Month", how="left")
    merged["Status"] = merged["Diff"].apply(lambda x: "⚠ MISMATCH" if x != 0 else "✓ MATCH")
    merged["Month"]  = merged["Month"].astype(str)
    return merged


# ══════════════════════════════════════════════════════════════════════════════
# 4. ROLLING AVERAGES (1-month, 3-month)
# ══════════════════════════════════════════════════════════════════════════════

def check_rolling_avg(monthly_trend_df):
    df = monthly_trend_df.copy()
    df[f"{LABEL_NEW}_1M_avg"]  = df[LABEL_NEW].rolling(1).mean().round(0)
    df[f"{LABEL_NEW}_3M_avg"]  = df[LABEL_NEW].rolling(3).mean().round(0)
    df[f"{LABEL_OLD}_1M_avg"]  = df[LABEL_OLD].rolling(1).mean().round(0)
    df[f"{LABEL_OLD}_3M_avg"]  = df[LABEL_OLD].rolling(3).mean().round(0)
    df["1M_avg_diff"]  = (df[f"{LABEL_NEW}_1M_avg"] - df[f"{LABEL_OLD}_1M_avg"]).round(0)
    df["3M_avg_diff"]  = (df[f"{LABEL_NEW}_3M_avg"] - df[f"{LABEL_OLD}_3M_avg"]).round(0)
    df["3M_avg_status"] = df["3M_avg_diff"].apply(
        lambda x: "⚠ LARGE DIFF" if abs(x) > 50000 else "✓ SIMILAR" if pd.notna(x) else "-"
    )
    keep_cols = ["Month", LABEL_NEW, LABEL_OLD,
                 f"{LABEL_NEW}_3M_avg", f"{LABEL_OLD}_3M_avg",
                 "3M_avg_diff", "3M_avg_status",
                 "MoM_Diff", "MoM_Diff %"]
    return df[[c for c in keep_cols if c in df.columns]]


