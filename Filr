# MASTER RUNNER
# ══════════════════════════════════════════════════════════════════════════════

def run_dq_and_export():
    print("Running DQ checks...")

    row_df       = check_row_counts(SOURCE_NEW, SOURCE_OLD)
    date_df      = check_approval_date(SOURCE_NEW, SOURCE_OLD, DATE_COL)
    monthly_df   = check_monthly_trend(SOURCE_NEW, SOURCE_OLD, DATE_COL)
    rolling_df   = check_rolling_avg(monthly_df)
    dup_df       = check_duplicates(SOURCE_NEW, SOURCE_OLD, DATE_COL, SC_ID_COL)
    sc_id_df, missing_ids, extra_ids = check_sc_id_overlap(SOURCE_NEW, SOURCE_OLD, SC_ID_COL)
    col_compare, dec_sample = cell_to_cell_compare(SOURCE_NEW, SOURCE_OLD, SC_ID_COL, DATE_COL)
    fill_df      = compare_fill_rates(SOURCE_NEW, SOURCE_OLD)
    summary_df   = build_summary(row_df, date_df, monthly_df, dup_df, sc_id_df, col_compare)

    print("Writing Excel report...")
    with pd.ExcelWriter(REPORT_PATH, engine="openpyxl") as writer:

        sheets = {
            "00_SUMMARY"           : summary_df,
            "01_Row_Counts"        : row_df,
            "02_Approval_Date"     : date_df,
            "03_Monthly_Trend"     : monthly_df,
            "04_Rolling_Avg"       : rolling_df,
            "05_Duplicates"        : dup_df,
            "06_SC_ID_Overlap"     : sc_id_df,
            "07_Missing_IDs"       : missing_ids,
            "08_Extra_IDs"         : extra_ids,
            "09_Column_Compare"    : col_compare,
            "10_Dec2025_Sample"    : dec_sample,
            "11_Fill_Rate"         : fill_df,
        }
        for sheet_name, df in sheets.items():
            df.to_excel(writer, sheet_name=sheet_name, index=False)

    # ── Post-process styling ──────────────────────────────────────────────────
    wb = load_workbook(REPORT_PATH)
    for sheet_name in wb.sheetnames:
        ws = wb[sheet_name]
        style_sheet(ws)
        # Red-fill ⚠ status cells
        for row in ws.iter_rows(min_row=2):
            for cell in row:
                if cell.value and isinstance(cell.value, str) and "⚠" in cell.value:
                    cell.fill = PatternFill("solid", fgColor="FFC7CE")
                    cell.font = Font(color="9C0006", bold=True)
                elif cell.value and isinstance(cell.value, str) and "✓" in cell.value:
                    cell.fill = PatternFill("solid", fgColor="C6EFCE")
                    cell.font = Font(color="276221", bold=True)

    # Freeze panes & tab colours
    colors = ["1F4E79","2E75B6","4472C4","5B9BD5","70AD47",
              "ED7D31","FFC000","FF0000","C00000","7030A0","0070C0","00B0F0"]
    for i, name in enumerate(wb.sheetnames):
        ws = wb[name]
        ws.freeze_panes = "B2"
        ws.sheet_properties.tabColor = colors[i % len(colors)]

    wb.save(REPORT_PATH)
    print(f"\n✅ DQ Report saved → {REPORT_PATH}")
    print("\nSheets written:")
    for k in sheets:
        print(f"  {k}: {len(sheets[k])} rows")
    return sheets

# ── RUN ───────────────────────────────────────────────────────────────────────
results = run_dq_and_export()
