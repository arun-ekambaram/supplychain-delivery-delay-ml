# 5. DUPLICATE CHECK (focus on Dec 2025)
# ══════════════════════════════════════════════════════════════════════════════

def check_duplicates(new_df, old_df, date_col, sc_id_col):
    rows = []
    for label, df in [(LABEL_NEW, new_df), (LABEL_OLD, old_df)]:
        # Overall duplicates
        dup_all = df.duplicated(subset=[sc_id_col]).sum()
        # Dec 2025 duplicates
        mask_dec = (pd.to_datetime(df[date_col]) >= DEC_2025_START) & \
                   (pd.to_datetime(df[date_col]) <= DEC_2025_END)
        df_dec   = df[mask_dec]
        dup_dec  = df_dec.duplicated(subset=[sc_id_col]).sum()
        rows.append({
            "Source"                   : label,
            "Total Rows"               : len(df),
            "Duplicate SC_IDs (All)"   : dup_all,
            "Dec 2025 Rows"            : len(df_dec),
            "Duplicate SC_IDs (Dec 25)": dup_dec,
            "Status"                   : "⚠ HAS DUPS" if dup_all > 0 else "✓ CLEAN"
        })
    return pd.DataFrame(rows)


# ══════════════════════════════════════════════════════════════════════════════
# 6. COMMON SCORECARD_IDs – MISSING & EXTRA
# ══════════════════════════════════════════════════════════════════════════════

def check_sc_id_overlap(new_df, old_df, sc_id_col):
    new_ids = set(new_df[sc_id_col].astype(str))
    old_ids = set(old_df[sc_id_col].astype(str))
    common  = new_ids & old_ids
    only_new = new_ids - old_ids          # in new but not old  → "enhancement / extra"
    only_old = old_ids - new_ids          # in old but not new  → "missing / dropped"
    result = pd.DataFrame([{
        "Total in New Source"       : len(new_ids),
        "Total in Old Source"       : len(old_ids),
        "Common IDs"                : len(common),
        "Only in New (extra)"       : len(only_new),
        "Only in Old (missing)"     : len(only_old),
        "Match %"                   : round(len(common) / len(old_ids) * 100, 2) if old_ids else None,
        "Status"                    : "⚠ DIFF" if only_new or only_old else "✓ SAME"
    }])
    # Sample missing IDs
    sample_missing = pd.DataFrame({"Scorecard_ID_missing_in_new": list(only_old)[:500]})
    sample_extra   = pd.DataFrame({"Scorecard_ID_extra_in_new"  : list(only_new)[:500]})
    return result, sample_missing, sample_extra


# ══════════════════════════════════════════════════════════════════════════════
# 7. CELL-TO-CELL VALUE COMPARISON (on common IDs)
# ══════════════════════════════════════════════════════════════════════════════

def cell_to_cell_compare(new_df, old_df, sc_id_col, date_col,
                         focus_start=DEC_2025_START, focus_end=DEC_2025_END):
    """
    For each column: count nulls, value mismatches, type mismatches.
    Also does a deep Dec-2025 cell-level compare.
    """
    # Align on common IDs
    common_ids = set(new_df[sc_id_col].astype(str)) & set(old_df[sc_id_col].astype(str))
    new_sub = new_df[new_df[sc_id_col].astype(str).isin(common_ids)].copy()
    old_sub = old_df[old_df[sc_id_col].astype(str).isin(common_ids)].copy()
    new_sub = new_sub.sort_values(sc_id_col).reset_index(drop=True)
    old_sub = old_sub.sort_values(sc_id_col).reset_index(drop=True)

    cols = [c for c in new_sub.columns if c in old_sub.columns]
    rows = []
    for col in cols:
        n_col = new_sub[col]
        o_col = old_sub[col]
        both_null  = (n_col.isna() & o_col.isna()).sum()
        new_null   = (n_col.isna() & o_col.notna()).sum()   # null in new, value in old
        old_null   = (n_col.notna() & o_col.isna()).sum()   # value in new, null in old
        # Value mismatch (where both not null)
        both_notna = n_col.notna() & o_col.notna()
        try:
            mismatch = (n_col[both_notna].astype(str) != o_col[both_notna].astype(str)).sum()
        except Exception:
            mismatch = None
        rows.append({
            "Column"                      : col,
            "New dtype"                   : str(n_col.dtype),
            "Old dtype"                   : str(o_col.dtype),
            "Type Changed"                : str(n_col.dtype) != str(o_col.dtype),
            "Both Null"                   : int(both_null),
            "Null in New (val in Old)"    : int(new_null),
            "Val in New (null in Old)"    : int(old_null),
            "Value Mismatch (both notna)" : mismatch,
            "Total Common Rows"           : len(new_sub),
            "Mismatch %"                  : round(mismatch / len(new_sub) * 100, 2) if mismatch else 0,
            "Issue Type"                  : (
                "NULL→VALUE" if new_null > 0 and mismatch == 0 else
                "VALUE→NULL" if old_null > 0 and mismatch == 0 else
                "VALUE MISMATCH" if mismatch and mismatch > 0 else
                "TYPE CHANGE" if str(n_col.dtype) != str(o_col.dtype) else
                "✓ CLEAN"
            )
        })

    col_compare = pd.DataFrame(rows).sort_values("Mismatch %", ascending=False)

    # ── Dec 2025 deep-dive: sample rows with any difference ──────────────────
    new_dec = new_sub[
        (pd.to_datetime(new_sub[date_col]) >= focus_start) &
        (pd.to_datetime(new_sub[date_col]) <= focus_end)
    ].copy()
    old_dec = old_sub[old_sub[sc_id_col].isin(new_dec[sc_id_col])].copy()
    new_dec = new_dec.set_index(sc_id_col)
    old_dec = old_dec.set_index(sc_id_col)

    diff_mask   = (new_dec.astype(str) != old_dec.astype(str))
    rows_w_diff = diff_mask.any(axis=1)
    sample_diff = new_dec[rows_w_diff].head(200).reset_index()
    sample_diff.insert(1, "__source__", "NEW")
    old_sample  = old_dec[rows_w_diff].head(200).reset_index()
    old_sample.insert(1, "__source__", "OLD")
    dec_sample  = pd.concat([sample_diff, old_sample]).sort_values([sc_id_col, "__source__"])

    return col_compare, dec_sample


